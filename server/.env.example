# Puerto del servidor API
PORT=4000

# Secreto para firmar los tokens JWT (cámbialo en producción)
JWT_SECRET=cambia-este-secreto-en-produccion

# ===== Base de datos =====
# Por defecto usa SQLite (archivo local, sin configuración).
DB_PATH=./data/lomas-lindas.db

# Para usar PostgreSQL, define DATABASE_URL (o DB_CLIENT=postgres + PG*).
# DATABASE_URL=postgres://lomas:lomas@localhost:5432/lomaslindas
# DB_CLIENT=postgres
# PGHOST=localhost
# PGPORT=5432
# PGUSER=lomas
# PGPASSWORD=lomas
# PGDATABASE=lomaslindas

# Origen permitido para CORS (frontend)
CLIENT_ORIGIN=http://localhost:5173

# URL pública del servidor (para los enlaces de credencial que se comparten
# por WhatsApp/correo). En producción, el dominio público del backend.
PUBLIC_URL=http://localhost:4000

# ===== Notificaciones por email (opcional) =====
# Si no se configuran, las notificaciones quedan en modo "simulado"
# (se registran en la bandeja de salida pero no se envían correos reales).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Centro de Retiro Lomas Lindas <no-reply@lomaslindas.com>"

# Correos de la Directiva que reciben aviso de incidentes graves/críticos
# (separados por coma). Ej: presidente@correo.com, seguridad@correo.com
DIRECTIVA_EMAILS=
