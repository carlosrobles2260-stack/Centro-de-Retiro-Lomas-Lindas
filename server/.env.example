# Puerto del servidor API
PORT=4000

# Secreto para firmar los tokens JWT (cámbialo en producción)
JWT_SECRET=cambia-este-secreto-en-produccion

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/lomas-lindas.db

# Origen permitido para CORS (frontend)
CLIENT_ORIGIN=http://localhost:5173

# ===== Notificaciones por email (opcional) =====
# Si no se configuran, las notificaciones quedan en modo "simulado"
# (se registran en la bandeja de salida pero no se envían correos reales).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Centro de Retiro Lomas Lindas <no-reply@lomaslindas.com>"
