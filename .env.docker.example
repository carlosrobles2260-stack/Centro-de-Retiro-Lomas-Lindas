# Configuración para despliegue con Docker Compose.
# Copia este archivo a .env (en la raíz) y ajusta los valores.

# Base de datos PostgreSQL
POSTGRES_USER=lomas
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=lomaslindas

# Seguridad del API (¡cámbialo!)
JWT_SECRET=cambia-este-secreto-en-produccion

# Puerto web público y origen permitido (CORS)
WEB_PORT=8080
CLIENT_ORIGIN=http://localhost:8080

# Notificaciones por email (opcional). Déjalo vacío para modo "simulado".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Centro de Retiro Lomas Lindas <no-reply@lomaslindas.com>"
